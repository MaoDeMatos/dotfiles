{
  "appearance": {
    "font": {
      "family": {
        "material": "Material Symbols Rounded",
        "mono": "Iosevka Term SS12",
        "sans": "Rubik"
      }
    }
  },
  "general": {
    "apps": {
      "terminal": ["foot"],
      "audio": ["pwvucontrol"]
    }
  },
  "background": {
    "enabled": true,
    "visualiser": {
      "enabled": false
    }
  },
  "bar": {
    "status": {
      "showAudio": true,
      "showBattery": true,
      "showBluetooth": true,
      "showKbLayout": true,
      "showNetwork": true
    },
    "tray": {
      "background": false,
      "recolour": true
    },
    "workspaces": {
      "activeIndicator": true,
      "activeLabel": "",
      "activeTrail": false,
      "label": " ",
      "occupiedBg": false,
      "occupiedLabel": " ",
      "rounded": true,
      "showWindows": false,
      "shown": 5
    }
  },
  "border": {
    "rounding": 24,
    "thickness": 8
  },
  "dashboard": {
    "mediaUpdateInterval": 1000
  },
  "launcher": {
    "vimKeybinds": true,
    "enableDangerousActions": false,
    "maxShown": 6,
    "maxWallpapers": 9,
    "useFuzzy": {
      "apps": false,
      "actions": false,
      "schemes": false,
      "variants": false,
      "wallpapers": false
    }
  },
  "lock": {
    "recolourLogo": true
  },
  "notifs": {
    "actionOnClick": true,
    "clearThreshold": 0.3,
    "defaultExpireTimeout": 6000,
    "expandThreshold": 20,
    "expire": true
  },
  "osd": {
    "hideDelay": 2000
  },
  "services": {
    "audioIncrement": 0.02,
    "useFahrenheit": false,
    "defaultPlayer": "YouTube Music",
    "playerAliases": [{
      "com.github.th_ch.youtube_music": "YouTube Music"
    }],
    "weatherLocation": "",
    "useFahrenheit": false,
    "useTwelveHourClock": false,
    "smartScheme": true,
    "visualiserBars": 32
  },
  "session": {
    "vimKeybinds": false
  }
}
